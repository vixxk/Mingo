# ─── TalkMingo Frontend Environment Variables ────────────────────────────
# Copy this file to `.env` and fill in real values.

# Backend API base URL
EXPO_PUBLIC_API_URL=https://your-backend-url.example.com

# OneSignal push notifications
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# Agora — used for audio & video calls (Agora API only). Must match the backend's AGORA_APP_ID.
# Create a project in the Agora Console and copy the App ID here.
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id

# CDN or S3 base URL for avatars and assets
EXPO_PUBLIC_CDN_URL=https://starpix-media-production.s3.ap-south-1.amazonaws.com
