# ─── Mingo Backend Environment Variables ─────────────────────────────
# Copy this file to `.env` and fill in real values.

# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mingo

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ZegoCloud — used for AUDIO calls (unchanged)
ZEGO_APP_ID=0
ZEGO_APP_SIGN=

# Agora — used for VIDEO calls
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# SMS (Fast2SMS)
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# Test & Admin credentials
ADMIN_EMAIL=
ADMIN_PASSCODE
TEST_ADMIN_EMAIL=
TEST_ADMIN_PHONE=
TEST_ADMIN_OTP=
TEST_LISTENER_PHONE=
TEST_LISTENER_OTP=

# OneSignal push notifications — required for the native incoming-call card +
# ringtone when the app is backgrounded/killed. App ID must match the client's
# EXPO_PUBLIC_ONESIGNAL_APP_ID (frontend/eas.json). REST API key from the
# OneSignal Dashboard → Settings → Keys & IDs.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
